const SUPABASE_URL = "https://rxwllokulbjrkbrcnikf.supabase.co"; 
const SUPABASE_ANON_KEY = "sb_publishable_TosgUWCBgC5bvX171JYGEw_8Q7IP9Ce";

function onFormSubmit(e) {
  // Since this script is attached directly to the Google Form (not the Sheet),
  // we must read the responses using e.response.getItemResponses()
  
  const itemResponses = e.response.getItemResponses();
  
  // The responses are in the same order as the questions on your form
  const fullName = itemResponses[0].getResponse();
  const mobileNumber = itemResponses[1].getResponse();
  const whatsappNumber = itemResponses[2].getResponse();
  const emailId = itemResponses[3].getResponse();

  // The endpoint to insert data into the 'pending_staff' table
  const url = `${SUPABASE_URL}/rest/v1/pending_staff`;

  // Format the data payload exactly matching your Supabase columns
  const payload = {
    name: fullName,
    mobile: mobileNumber,
    whatsapp: whatsappNumber,
    email: emailId,
    status: 'Pending'
  };

  const options = {
    method: 'post',
    contentType: 'application/json',
    headers: {
      'apikey': SUPABASE_ANON_KEY,
      'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
      'Prefer': 'return=minimal'
    },
    payload: JSON.stringify(payload)
  };

  try {
    UrlFetchApp.fetch(url, options);
    Logger.log("Application successfully sent to Supabase.");
  } catch (error) {
    Logger.log("Error sending to Supabase: " + error.toString());
  }
}
